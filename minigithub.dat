    int score = ReplaceWithMinusOne(array);

    printf("The score is: %d\n", score);

    FallDownAndReplace(array);
    char code[1000] = "";

    char variables[1000] = "";

    FindAllVariables(variables, code);
    FindAllVariablesInScope(variables, code, 12);

    return 0;
}
