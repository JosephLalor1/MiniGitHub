    }

    char wordList[11] = {'a', 'b', 'c', ' ', 'f', 'g', 'h', ' ', 'g', 'g', 'g'};

    printf("There are %d words in the sentence\n", wordCounter(11, wordList));

    int array[4][6] = { {0,0,3,3,3,4},
                       {0,0,2,3,4,3},
                       {0,0,1,3,3,2},
                       {0,0,1,1,1,1} };
    PrintArray(array);
    int score = ReplaceWithMinusOne(array);

    printf("The score is: %d\n", score);

    FallDownAndReplace(array);
    char code[1000] = "";

    char variables[1000] = "";

    FindAllVariables(variables, code);
    FindAllVariablesInScope(variables, code, 12);

    return 0;
}
