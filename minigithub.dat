904:<!-- Oyindamola Olaosun -->
<!-- C00313475 -->

<?php
    // Connects to the db file
    include "db.inc.php";

    // Selects all clients from the table
    $sql = "SELECT ClientID, Name FROM Client";
    // $sql = "SELECT ClientID, Name FROM Client WHERE DeletedFlag = 0";

    // Error Handling
    if (!$result = mysqli_query($con, $sql)) {
        die("Error in querying the database" . mysqli_error($con));
    }

    // listClientID
    // Using the mysqli_fetch_array()
    echo "<option value=''>---Client List----</option>";

    // mysqli_fetch_array($result) fetches a result row as an associative array
    while ($row = mysqli_fetch_array($result)) {
        $id   = $row['ClientID'];
        $name = $row['Name'];
        $text = "${id}. ${name}";
        echo "<option value='$text'>$id $name</option>";
    }

    echo "</select>";

    // Close the connection
    mysqli_close($con);
?>
4300:/*  Project work*/
/* Group CSS  */

/* Selects all the elements in the html pagw for styling */
*,
*::before,
*::after { box-sizing: border-box; }

html, body { height: 100%; }

/* Body Styles */
body{
  margin:0;
  font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
  background:#f5f7fb;
  color:#0f172a;
  line-height:1.4;
}

 /* Highlight the first panel (client select) */
.office-panel:first-child{
  background:#0b1220;
  border-color:#818cf8;
}


/* Card */
.card{
  width:min(1200px,96vw);
  margin:28px auto;
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:14px;
  box-shadow:0 12px 30px rgba(15,23,42,.08);
  overflow:hidden;
}

.content__top{
  padding:20px 22px;
  border-bottom:1px solid #e5e7eb;
  background:linear-gradient(180deg,#fff,#fbfcff);
}

.content__top h2{ margin:0; font-size:1.25rem; }

/* Layout */
.layout{
  display:grid;
  grid-template-columns:260px 1fr;
  min-height:640px;
}

/* Sidebar */
.sidebar{
  border-right:1px solid #e5e7eb;
  background:#0b1220;
  color:#e5e7eb;
  padding:16px 14px;
  height: 50%;
}

.brand-side{
  display:flex;
  align-items:center;
  justify-content:center;
  padding:10px 8px 16px;
}

.brand-side__logo{ width:140px; max-width:100%; height:auto; }

.side-title{
  margin:10px 8px 12px;
  font-size:.85rem;
  color:#cbd5e1;
  text-transform:uppercase;
  letter-spacing:.08em;
}

.side-menu{
  list-style:none;
  padding:0;
  margin:0;
  display:grid;
  gap:10px;
}

.side-divider{
  height:1px;
  background:rgba(226,232,240,.18);
  margin:10px 6px;
}

.side-menu__link{
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px;
  border-radius:10px;
  color:#e5e7eb;
  text-decoration:none;
}

.side-menu__link:hover{ background:rgba(148,163,184,.16); }

.side-menu__link.is-active{
  background:rgba(30,58,138,.22);
  outline:1px solid rgba(30,58,138,.35);
}

li.danger .side-menu__link{
  margin-top:10px;
  background:rgba(239,68,68,.12);
  outline:1px solid rgba(239,68,68,.25);
}

/* Main content */
.office-grid{ padding:18px; background:#fbfdff; }

.office-grid .office-panel:first-child{
  max-width:420px;
  margin:0 auto 14px;
}

.office-panel{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:12px;
  padding:16px;
  box-shadow:0 8px 22px rgba(15,23,42,.04);
  margin-bottom:14px; 
}

/* Office Details box */
fieldset{
  border:2px solid #0b1220;
  border-radius:12px;
  padding:14px;
}

legend{ padding:0 10px; color:#0b1220; font-weight:700; }


/* Two columns */
.two-col{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
}

/* Form controls */
.inputbox{
  display:grid;
  gap:6px;            /* space between label and input */
  margin-bottom:18px; /* space between fields */
}

label{ font-size:.9rem; color:#334155; font-weight:700; }

.required{ color:#ef4444; }

input[type="text"],
input[type="number"],
select,
textarea{
  width:100%;
  padding:11px 12px;
  border:1px solid #e5e7eb;
  border-radius:10px;
  background:#fff;
  color:#0f172a;
  outline:none;
  min-width:0;
}

input:focus,
select:focus,
textarea:focus{
  border-color:rgba(30,58,138,.8);
  box-shadow:0 0 0 4px rgba(30,58,138,.12);
}

textarea{ resize:vertical; min-height:90px; }

/* Disabled fields */
input:disabled,
select:disabled,
textarea:disabled{
  background:#f1f5f9;
  color:#64748b;
  border-color:#e2e8f0;
  cursor:not-allowed;
}

/* Buttons */
.form-actions{
  display:flex;
  gap:10px;
  justify-content:center;
  padding-top:12px;
}

input[type="submit"],
input[type="reset"]{
  border:1px solid #e5e7eb;
  border-radius:10px;
  padding:10px 14px;
  cursor:pointer;
  font-weight:800;
  transition:all 0.2s ease;
}

/* Submit base */
input[type="submit"]{
  background:#0b1220;
  border-color:rgba(30,58,138,.8);
  color:#fff;
}

/* Reset base */
input[type="reset"]{
  background:#fff;
  color:#0f172a;
}

/* Hover ONLY when enabled */
input[type="submit"]:not(:disabled):hover{
  background:#1e3a8a;
  border-color:#1e3a8a;
}

input[type="reset"]:not(:disabled):hover{
  background:#374151;
  border-color:#374151;
  color:#fff;
}

/* Disabled buttons (grey + no hover) */
input[type="submit"]:disabled,
input[type="reset"]:disabled{
  background:#e5e7eb;
  color:#9ca3af;
  border-color:#e5e7eb;
  cursor:not-allowed;
  box-shadow:none;
  transform:none;
}
